  "session_id": "7a7099f0-8f12-4ef1-bc08-29e5fabbbff8",
  "transcript_path": "/tmp/.claude/projects/-tmp-aws-s3-file-upload/7a7099f0-8f12-4ef1-bc08-29e5fabbbff8.jsonl",
  "cwd": "/tmp/aws-s3-file-upload",
  "permission_mode": "bypassPermissions",
